# Application
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=libsql://newwebsite-marri-kokoserver.aws-ap-northeast-1.turso.io
DATABASE_MAX_CONNECTIONS=10

# Shared rate limiting (recommended for production and multiple app instances)
REDIS_URL=redis://localhost:6379

# SMTP email delivery (required in production for password resets and newsletters)
EMAIL_SMTP_HOST=smtppro.zoho.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=contact@tichly.com
EMAIL_SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Daily Chronicle <contact@tichly.com>
EMAIL_REPLY_TO=contact@tichly.com

# Seeded local administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-locally

# Bunny Storage (required for newsroom uploads)
BUNNY_API_KEY=your-account-api-key
BUNNYCDN_PULL_ZONE_ID=your-pull-zone-id
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_PASSWORD=your-storage-zone-password
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_CDN_URL=https://your-pull-zone.b-cdn.net
BUNNY_UPLOAD_MAX_BYTES=15728640

# Publication
COMMENT_AUTO_APPROVE=false
